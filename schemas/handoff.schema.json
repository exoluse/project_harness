{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-harness.local/schemas/handoff.schema.json",
  "type": "object",
  "required": ["schema", "id", "kind", "task_id", "claim_id", "task_fingerprint", "plan_id", "plan_fingerprint", "from_agent", "to_agent", "owned_paths", "changed_files", "changed_file_states", "summary", "verification", "verification_state", "unverified", "risks", "next_action"],
  "properties": {
    "schema": {"const": "harness.handoff/v1"},
    "id": {"type": "string", "pattern": "^HOF-[0-9]{4,}$"},
    "kind": {"const": "handoff"},
    "changed_file_states": {"type": "object", "additionalProperties": {"type": "string"}},
    "verification": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["command", "outcome"],
        "properties": {
          "command": {"type": "string", "minLength": 1},
          "outcome": {"type": "string", "minLength": 1}
        }
      }
    },
    "verification_state": {"enum": ["PASS", "FAIL", "INCOMPLETE"]},
    "next_action": {"type": "string", "minLength": 1}
  },
  "additionalProperties": true
}
