{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-harness.local/schemas/state.schema.json",
  "type": "object",
  "required": ["schema", "project_id", "lifecycle_state", "current_plan", "active_plan", "active_baselines", "active_release", "updated_at"],
  "properties": {
    "schema": {"const": "harness.state/v1"},
    "project_id": {"type": "string", "minLength": 1},
    "lifecycle_state": {"enum": ["OPPORTUNITY", "DISCOVERY", "CONTRACTED", "SPECIFYING", "PLANNING", "DECISION_READY", "APPROVED", "BUILDING", "VERIFYING", "CUSTOMER_ACCEPTANCE", "DEPLOYING", "CLOSED", "MAINTAINING", "ON_HOLD", "CANCELLED"]},
    "current_plan": {"type": "string", "pattern": "^PLAN-[0-9]{4,}$"},
    "active_plan": {"type": ["string", "null"]},
    "active_decision": {"type": ["string", "null"], "pattern": "^APR-[0-9]{4,}$"},
    "active_baselines": {"type": "object"},
    "active_release": {"type": ["string", "null"]},
    "updated_at": {"type": "string"}
  },
  "additionalProperties": true
}
