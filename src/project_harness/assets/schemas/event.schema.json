{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-harness.local/schemas/event.schema.json",
  "type": "object",
  "required": ["schema", "id", "kind", "event_type", "occurred_at", "payload"],
  "properties": {
    "schema": {"const": "harness.event/v1"},
    "id": {"type": "string", "pattern": "^EVT-[0-9]{4,}$"},
    "kind": {"const": "event"},
    "event_type": {"type": "string", "minLength": 1},
    "occurred_at": {"type": "string", "format": "date-time"},
    "payload": {"type": "object"}
  },
  "additionalProperties": false
}
