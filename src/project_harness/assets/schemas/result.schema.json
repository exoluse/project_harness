{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-harness.local/schemas/result.schema.json",
  "type": "object",
  "required": ["schema", "id", "kind", "status", "task_id", "claim_id", "agent", "summary", "changed_files", "changed_file_states", "verification", "verification_state", "evidence_refs", "evidence_fingerprints", "limitations", "task_fingerprint", "plan_fingerprint", "base_commit", "head_commit", "build_fingerprint"],
  "properties": {
    "schema": {"const": "harness.result/v1"},
    "id": {"type": "string", "pattern": "^RES-[0-9]{4,}$"},
    "kind": {"const": "result"},
    "changed_files": {"type": "array", "items": {"type": "string"}},
    "changed_file_states": {"type": "object", "additionalProperties": {"type": "string"}},
    "verification": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["command", "outcome"]}},
    "verification_state": {"enum": ["PASS", "FAIL", "INCOMPLETE"]},
    "evidence_refs": {"type": "array", "items": {"type": "string", "pattern": "^EVD-"}},
    "evidence_fingerprints": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
    "task_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "plan_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "base_commit": {"type": ["string", "null"]},
    "head_commit": {"type": ["string", "null"]},
    "build_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": true
}
