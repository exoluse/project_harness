{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-harness.local/schemas/requirement.schema.json",
  "type": "object",
  "required": ["schema", "id", "kind", "version", "status", "required", "statement", "source_refs", "acceptance_criteria"],
  "properties": {
    "schema": {"const": "harness.requirement/v1"},
    "id": {"type": "string", "pattern": "^REQ-[0-9]{4,}$"},
    "kind": {"const": "requirement"},
    "version": {"type": "string"},
    "status": {"enum": ["CANDIDATE", "CLARIFICATION_REQUIRED", "APPROVED", "PLANNED", "IMPLEMENTED", "VERIFIED", "ACCEPTED", "SUPERSEDED"]},
    "required": {"type": "boolean"},
    "statement": {"type": "string"},
    "source_refs": {"type": "array", "items": {"type": "string", "pattern": "^SRC-"}},
    "acceptance_criteria": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}

