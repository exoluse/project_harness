{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-harness.local/schemas/approval.schema.json",
  "type": "object",
  "required": ["schema", "id", "kind", "project_id", "authority_id", "authority_sequence", "decision_id", "decision_at", "approval_type", "decision", "authority_role", "approved_by", "basis", "subject_id", "subject_path", "subject_fingerprint", "snapshot_manifest", "conditions", "condition_refs", "attestation"],
  "properties": {
    "schema": {"const": "harness.approval/v1"},
    "id": {"type": "string", "pattern": "^APR-[0-9]{4,}$"},
    "kind": {"const": "approval"},
    "project_id": {"type": "string", "minLength": 1},
    "authority_id": {"type": "string", "minLength": 1},
    "authority_sequence": {"type": "integer", "minimum": 1},
    "record_sequence": {"type": "integer", "minimum": 1},
    "decision_id": {"type": "string", "minLength": 1},
    "decision_at": {"type": "string", "format": "date-time"},
    "decision": {"enum": ["APPROVED", "APPROVED_WITH_CONDITIONS", "REVISION_REQUIRED", "DEFERRED", "REJECTED", "REVOKED"]},
    "authority_role": {"const": "HUMAN_PROJECT_OWNER"},
    "assurance": {"enum": ["PROCEDURAL", "CRYPTOGRAPHIC"]},
    "subject_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "snapshot_manifest": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["path", "snapshot_path", "sha256"]}},
    "conditions": {"type": "array", "items": {"type": "string"}},
    "condition_refs": {"type": "array", "items": {"type": "string", "pattern": "^OI-"}},
    "attestation": {"type": "object"}
  },
  "additionalProperties": true
}
