{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-harness.local/schemas/feature.schema.json",
  "type": "object",
  "required": ["schema", "id", "kind", "version", "status", "required", "requirement_refs", "completion_criteria"],
  "properties": {
    "schema": {"const": "harness.feature/v1"},
    "id": {"type": "string", "pattern": "^FUNC-[0-9]{4,}$"},
    "kind": {"const": "feature"},
    "status": {"enum": ["CANDIDATE", "SPECIFIED", "PLANNED", "IMPLEMENTED", "PARTIAL", "INCONCLUSIVE", "VERIFIED", "ACCEPTED", "SUPERSEDED"]},
    "required": {"type": "boolean"},
    "requirement_refs": {"type": "array", "items": {"type": "string", "pattern": "^REQ-"}},
    "customer_acceptance_required": {"type": "boolean"},
    "completion_criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "statement", "required", "verification_plan", "required_profiles", "required_bindings", "evidence_refs"],
        "properties": {
          "id": {"type": "string", "pattern": "^AC-"},
          "statement": {"type": "string", "minLength": 1},
          "required": {"type": "boolean"},
          "verification_plan": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "required_profiles": {"type": "array", "items": {"type": "string"}},
          "required_bindings": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "evidence_refs": {"type": "array", "items": {"type": "string", "pattern": "^EVD-"}}
        }
      }
    }
  },
  "additionalProperties": true
}
