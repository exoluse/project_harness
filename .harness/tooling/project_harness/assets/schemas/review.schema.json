{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-harness.local/schemas/review.schema.json",
  "type": "object",
  "required": ["schema", "id", "kind", "result_id", "reviewer", "decision", "basis", "checks", "result_fingerprint", "result_build_fingerprint"],
  "properties": {
    "schema": {"const": "harness.review/v1"},
    "id": {"type": "string", "pattern": "^VRD-[0-9]{4,}$"},
    "kind": {"const": "review"},
    "decision": {"enum": ["PASS", "CHANGES_REQUIRED", "REJECTED", "INCONCLUSIVE"]},
    "checks": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "result_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "result_build_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": true
}
