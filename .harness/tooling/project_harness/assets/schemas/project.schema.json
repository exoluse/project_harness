{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-harness.local/schemas/project.schema.json",
  "type": "object",
  "required": ["schema", "id", "kind", "name", "required_features", "approval_dependencies", "closure_contract", "policy"],
  "properties": {
    "schema": {"const": "harness.project/v1"},
    "id": {"type": "string", "minLength": 1},
    "kind": {"const": "project"},
    "required_features": {"type": "array", "items": {"type": "string", "pattern": "^FUNC-"}},
    "approval_dependencies": {"type": "array", "items": {"type": "string"}},
    "closure_contract": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "required", "required_profiles", "evidence_refs"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "required": {"type": "boolean"},
          "required_profiles": {"type": "array", "items": {"type": "string"}},
          "evidence_refs": {"type": "array", "items": {"type": "string", "pattern": "^EVD-"}}
        }
      }
    },
    "policy": {
      "type": "object",
      "properties": {
        "execution_mode": {"const": "PLAN_GATED"},
        "claim_mode": {"enum": ["WHEN_CONCURRENT", "REQUIRED"]},
        "record_mode": {"enum": ["ON_DEMAND", "REQUIRED"]},
        "human_approval_required_for": {"type": "array", "items": {"type": "string"}},
        "default_claim_ttl_minutes": {"type": "integer", "minimum": 1},
        "approval_assurance": {
          "type": "object",
          "required": ["default", "by_type"],
          "properties": {
            "default": {"enum": ["PROCEDURAL", "CRYPTOGRAPHIC"]},
            "by_type": {
              "type": "object",
              "additionalProperties": {"enum": ["PROCEDURAL", "CRYPTOGRAPHIC"]}
            }
          },
          "additionalProperties": false
        }
      }
    }
  },
  "additionalProperties": true
}
