{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-harness.local/schemas/claim.schema.json",
  "type": "object",
  "required": ["schema", "id", "kind", "status", "agent", "task_id", "task_fingerprint", "plan_id", "plan_fingerprint", "paths", "logical_locks", "worktree", "worktree_snapshot", "acquired_at", "expires_at"],
  "properties": {
    "schema": {"const": "harness.claim/v1"},
    "id": {"type": "string", "pattern": "^CLM-[0-9]{4,}$"},
    "kind": {"const": "claim"},
    "paths": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "logical_locks": {"type": "array", "items": {"type": "string"}},
    "worktree_snapshot": {"type": "object"}
  },
  "additionalProperties": true
}
