{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-harness.local/schemas/recovery.schema.json",
  "type": "object",
  "required": [
    "schema",
    "id",
    "kind",
    "claim_id",
    "recovered_by",
    "observed_at",
    "checks",
    "decision",
    "reason"
  ],
  "properties": {
    "schema": {"const": "harness.recovery/v1"},
    "id": {"type": "string", "pattern": "^RCV-[0-9]{4,}$"},
    "kind": {"const": "recovery"},
    "claim_id": {"type": "string", "pattern": "^CLM-[0-9]{4,}$"},
    "recovered_by": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$"
    },
    "observed_at": {"type": "string", "format": "date-time"},
    "checks": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": ["name", "outcome", "detail", "detail_sha256"],
        "properties": {
          "name": {
            "enum": [
              "process",
              "worktree",
              "diff",
              "outbox",
              "external_side_effects"
            ]
          },
          "outcome": {"enum": ["PASS"]},
          "detail": {"type": "string", "minLength": 1},
          "detail_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "reconciliation": {"enum": ["NONE", "RECONCILED"]},
          "idempotency_keys": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "receipts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["path", "sha256"],
              "properties": {
                "path": {"type": "string", "minLength": 1},
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "decision": {"const": "ABANDON_AND_RECLAIM"},
    "reason": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
