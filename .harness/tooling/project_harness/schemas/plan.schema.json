{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-harness.local/schemas/plan.schema.json",
  "type": "object",
  "required": ["schema", "id", "kind", "version", "status", "approval_dependencies", "approval_subject"],
  "properties": {
    "schema": {"const": "harness.plan/v1"},
    "id": {"type": "string", "pattern": "^PLAN-[0-9]{4,}$"},
    "kind": {"const": "plan"},
    "status": {"enum": ["DRAFT", "PREFLIGHT", "NOT_READY", "BLOCKED", "DECISION_READY", "APPROVED", "APPROVED_WITH_CONDITIONS", "ACTIVE", "PARTIALLY_STALE", "STALE", "SUPERSEDED", "CLOSED"]},
    "decision_ref": {"type": ["string", "null"], "pattern": "^APR-[0-9]{4,}$"},
    "decision_applied_at": {"type": ["string", "null"], "format": "date-time"},
    "approval_dependencies": {"type": "array", "items": {"type": "string"}},
    "derived_approval_dependencies": {"type": "array", "items": {"type": "string"}},
    "approval_subject": {
      "type": "object",
      "required": ["requirement_refs", "feature_refs", "work_item_refs", "workstreams", "verification_strategy", "authorized_actions", "excluded_actions", "invalidation_triggers"],
      "properties": {
        "requirement_refs": {"type": "array", "items": {"type": "string", "pattern": "^REQ-"}},
        "feature_refs": {"type": "array", "items": {"type": "string", "pattern": "^FUNC-"}},
        "work_item_refs": {"type": "array", "items": {"type": "string", "pattern": "^TASK-"}},
        "workstreams": {"type": "array", "items": {"type": "object"}},
        "verification_strategy": {"type": "object"},
        "authorized_actions": {"type": "array", "items": {"type": "string"}},
        "excluded_actions": {"type": "array", "items": {"type": "string"}},
        "invalidation_triggers": {"type": "array", "items": {"type": "string"}},
        "decision_scope": {
          "type": "object",
          "required": ["schema", "scope_id", "requirements", "features", "changes", "dependencies", "write_scope", "authorized_actions", "excluded_actions", "max_risk", "verification", "criterion_verification", "constraints"],
          "properties": {
            "schema": {"const": "harness.execution-scope/v1"},
            "scope_id": {"type": "string", "pattern": "^PLAN-[0-9]{4,}$"},
            "requirements": {"type": "object"},
            "features": {"type": "object"},
            "changes": {"type": "object"},
            "dependencies": {"type": "array", "items": {"type": "object", "required": ["path", "definition"], "properties": {"path": {"type": "string"}, "definition": {"type": "object"}}, "additionalProperties": false}},
            "constraints": {"type": "object"},
            "write_scope": {"type": "array", "items": {"type": "string"}},
            "authorized_actions": {"type": "array", "items": {"type": "string"}},
            "excluded_actions": {"type": "array", "items": {"type": "string"}},
            "verification": {"type": "array", "items": {"type": "string"}},
            "criterion_verification": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string"}}},
            "max_risk": {"enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]}
          },
          "additionalProperties": false
        }
      }
    }
  },
  "additionalProperties": true
}
