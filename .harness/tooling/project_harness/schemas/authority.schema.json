{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-harness.local/schemas/authority.schema.json",
  "type": "object",
  "required": [
    "schema",
    "authority_id",
    "repository_root",
    "protection",
    "signature_namespace",
    "allowed_signers_path",
    "allowed_signers_sha256",
    "decision_ledger_path",
    "approval_types"
  ],
  "properties": {
    "schema": {"const": "harness.authority/v1"},
    "authority_id": {"type": "string", "minLength": 1},
    "repository_root": {"type": "string", "minLength": 1},
    "protection": {"const": "OS_ACL_OR_EXTERNAL_BROKER"},
    "signature_namespace": {"type": "string", "minLength": 1},
    "allowed_signers_path": {"type": "string", "minLength": 1},
    "allowed_signers_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "decision_ledger_path": {"type": "string", "minLength": 1},
    "approval_types": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "additionalProperties": false
}
